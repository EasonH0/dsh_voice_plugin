{
  "name": "dsh-voice-input",
  "version": "0.1.0",
  "description": "DSH 语音输入插件：浏览器 Web Speech 语音识别（零安装、开箱即用）+ LLM 润色（粤语口语转繁体书面语）",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test --test-isolation=none \"test/*.test.mjs\""
  },
  "files": [
    "lib/**/*",
    "cordis.patch.yml",
    "README.md",
    "INSTALL.md",
    "LICENSE"
  ],
  "license": "Apache-2.0",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-plugins",
    "cordis",
    "cordis-plugin",
    "voice",
    "voice-input",
    "speech",
    "speech-recognition",
    "speech-to-text",
    "asr",
    "cantonese",
    "webspeech"
  ],
  "engines": {
    "node": ">=18.0.0"
  }
}
